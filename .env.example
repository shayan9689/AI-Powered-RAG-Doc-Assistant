# Backend
APP_NAME=RAG Document Assistant
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,https://ai-powered-rag-doc-assistant.vercel.app
AUTH_REQUIRED=false
RATE_LIMIT_PER_MINUTE=60

# Supabase (backend uses the service role key; never expose it to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
MIN_RETRIEVAL_SCORE=0.12
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ingestion
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Embeddings and vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=document_chunks
RETRIEVAL_TOP_K=5
HYBRID_RETRIEVAL=true
RERANK_RESULTS=true
REWRITE_FOLLOWUPS=true
DATA_DIR=./data
